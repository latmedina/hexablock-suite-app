{
  "name": "hexablock-agent-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Agent factory for HexaBlock Suite: role-based agents on free OpenRouter models, orchestrated by Next.js",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "models:check": "tsx scripts/check-free-models.ts",
    "pipeline": "tsx scripts/run-pipeline.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
