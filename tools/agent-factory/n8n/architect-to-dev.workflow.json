{
  "name": "HexaBlock - Architect to Dev",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hexablock/architect-to-dev",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1f1e0c2-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:3100/api/agents/architect",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: $json.body.request }) }}",
        "options": {
          "timeout": 300000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer __FACTORY_TOKEN__"
            }
          ]
        }
      },
      "id": "a1f1e0c2-0002-4000-8000-000000000002",
      "name": "Agent 1 - Architect",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://127.0.0.1:3100/api/agents/' + ($json.output.module.startsWith('api/') ? 'dev-api' : 'dev-app') }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ module: $json.output.module, prompt: 'Implement the following approved spec. Do not change its interfaces or acceptance tests.\\n```json\\n' + JSON.stringify($json.output, null, 2) + '\\n```' }) }}",
        "options": {
          "timeout": 300000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer __FACTORY_TOKEN__"
            }
          ]
        }
      },
      "id": "a1f1e0c2-0003-4000-8000-000000000003",
      "name": "Agent 2 - Dev",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ spec: $('Agent 1 - Architect').item.json.output, patch: $json.output, models: { architect: $('Agent 1 - Architect').item.json.model, dev: $json.model } }) }}",
        "options": {}
      },
      "id": "a1f1e0c2-0004-4000-8000-000000000004",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        0
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Agent 1 - Architect",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Agent 1 - Architect": {
      "main": [
        [
          {
            "node": "Agent 2 - Dev",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Agent 2 - Dev": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
