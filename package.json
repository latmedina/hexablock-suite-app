{
  "name": "hexablock-suite-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "dependency-cruiser": "^18.7.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint:arch": "depcruise src --config .dependency-cruiser.js",
    "prepare": "husky"
  },
