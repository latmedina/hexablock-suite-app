# Copy to .env.local (git-ignored). Never commit a real key.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Paths to the two repos, relative to tools/agent-factory
# APP_REPO_ROOT=../..
# API_REPO_ROOT=../../../hexablock-suite-api
# Override a model chain without touching code (every id must end in :free):
# AGENT_DEV_APP_MODELS=cohere/north-mini-code:free,nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_TIMEOUT_MS=180000
# Required when the app listens on the network (n8n over Tailscale): callers send Authorization: Bearer <token>
# FACTORY_TOKEN=
# Verification step: apply each patch to a temp git worktree and run typecheck, lint:tests, lint:arch and tests,
# then give Dev up to MAX_REPAIR_ROUNDS rounds to fix failures. It RUNS the generated tests on this machine.
# VERIFY_PATCHES=1
# MAX_REPAIR_ROUNDS=2
# Ask the Reviewer agent for a verdict on the final patch (never blocks it)
# REVIEW_PATCHES=1
# Where runs, results and dashboard events are stored
# RUNS_DIR=.runs
